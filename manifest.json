{
  "manifest_version": 3,
  "name": "EdgeShield - On-Device Vision Agent",
  "version": "1.0.0",
  "description": "Privacy-preserving on-device visual perception and DOM masking agent.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.ts"],
      "run_at": "document_start"
    }
  ],
  "minimum_chrome_version": "113"
}